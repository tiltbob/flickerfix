#!/bin/sh
# Automated eDP link-training test. Runs from the initramfs at boot.
#
# Each cycle turns the panel off and on again (framebuffer blank, then
# suspend/resume), which makes the driver retrain the eDP link. After each
# retrain it records the drive settings the training ended on and the
# panel's own symbol error counters.
#
# The EFI binary this runs from is installed as EFI/flickerfix/*.efi on an
# EFI system partition. Results are collected in RAM and saved as one
# tarball, EFI/flickerfix/results/<run>.tar.gz, on that partition. The
# partition is only mounted for the moment a tarball is written.

DPMS_CYCLES=150
SUSPEND_CYCLES=15
MEASURE_SECS=3
IDLE_SECS=2
SAVE_EVERY=10		# save the tarball every this many screen cycles
END_ACTION=reboot	# reboot, poweroff or stay
END_SECS=20

VARIANT=$(cat /etc/flickerfix-variant 2>/dev/null || echo unknown)
ESP=/mnt/esp
ESP_DIR=EFI/flickerfix
WORK=/run/flickerfix
FB_BLANK=/sys/class/graphics/fb0/blank

say() { echo "$*"; }

# The partition the results go to: the first FAT partition that has an
# EFI/flickerfix directory. Other partitions are not touched.
find_esp() {
	local p dev
	for p in /sys/class/block/*; do
		[ -e "$p/partition" ] || continue
		dev=/dev/${p##*/}
		blkid "$dev" 2>/dev/null | grep -q 'TYPE="vfat"' || continue
		mount -t vfat -o ro "$dev" "$ESP" 2>/dev/null || continue
		if [ -d "$ESP/$ESP_DIR" ]; then
			umount "$ESP"
			echo "$dev"
			return 0
		fi
		umount "$ESP"
	done
	return 1
}

# Pack the run directory and put the tarball on the EFI system partition.
save() {
	[ -n "$ESP_DEV" ] || return 1
	tar -cf - -C "$WORK" "$RUN" | gzip > "$WORK/$RUN.tar.gz" || return 1
	mount -t vfat "$ESP_DEV" "$ESP" || return 1
	mkdir -p "$ESP/$ESP_DIR/results" &&
		cp "$WORK/$RUN.tar.gz" "$ESP/$ESP_DIR/results/$RUN.tar.gz.tmp" &&
		mv -f "$ESP/$ESP_DIR/results/$RUN.tar.gz.tmp" "$ESP/$ESP_DIR/results/$RUN.tar.gz"
	local rc=$?
	sync
	umount "$ESP"
	return $rc
}

finish() {	# finish <message>
	say
	say "=================================================="
	say " $1"
	if save; then
		say " Results: $ESP_DIR/results/$RUN.tar.gz"
		say " on the EFI system partition ($ESP_DEV)."
	else
		say " ERROR: THE RESULTS COULD NOT BE SAVED."
	fi
	say "=================================================="
	case $END_ACTION in
	reboot)
		say "Rebooting in $END_SECS seconds."
		sleep "$END_SECS"; reboot -f ;;
	poweroff)
		say "Powering off in $END_SECS seconds."
		sleep "$END_SECS"; poweroff -f ;;
	esac
	exit 0
}

mount -t debugfs none /sys/kernel/debug 2>/dev/null
mkdir -p "$ESP" "$WORK"

say "flickerfix test, $VARIANT kernel $(uname -r)"
say "Looking for the EFI system partition with $ESP_DIR ..."
ESP_DEV=
for i in $(seq 1 30); do
	ESP_DEV=$(find_esp) && break
	sleep 1
done

n=1
if [ -n "$ESP_DEV" ] && mount -t vfat -o ro "$ESP_DEV" "$ESP"; then
	[ -f "$ESP/$ESP_DIR/flickerfix.conf" ] && . "$ESP/$ESP_DIR/flickerfix.conf"
	while [ -e "$ESP/$ESP_DIR/results/flickerfix-run-$(printf '%03d' $n)-$VARIANT.tar.gz" ]; do
		n=$((n + 1))
	done
	umount "$ESP"
else
	ESP_DEV=
	say "ERROR: no partition with $ESP_DIR found. Nothing will be saved."
	sleep 20
fi
RUN=flickerfix-run-$(printf '%03d' $n)-$VARIANT
OUT=$WORK/$RUN
mkdir -p "$OUT/dmesg"
CSV="$OUT/cycles.csv"

EDP_DBG=$(ls -d /sys/kernel/debug/dri/*/eDP-* 2>/dev/null | head -n1)
EDP_SYS=$(ls -d /sys/class/drm/card*-eDP-* 2>/dev/null | head -n1)
AUX=
if [ -n "$EDP_SYS" ]; then
	AUX=$(ls -d "$EDP_SYS"/drm_dp_aux* 2>/dev/null | head -n1)
	AUX=/dev/${AUX##*/}
fi

{
	echo "variant:   $VARIANT"
	echo "kernel:    $(uname -r) $(uname -v)"
	echo "cmdline:   $(cat /proc/cmdline)"
	echo "date:      $(date '+%F %T') (RTC)"
	echo "vendor:    $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)"
	echo "product:   $(cat /sys/class/dmi/id/product_name 2>/dev/null)"
	echo "board:     $(cat /sys/class/dmi/id/board_name 2>/dev/null)"
	echo "bios:      $(cat /sys/class/dmi/id/bios_version 2>/dev/null)"
	echo "connector: $EDP_SYS"
	echo "debugfs:   $EDP_DBG"
	echo "aux:       $AUX"
	echo "esp:       $ESP_DEV"
	echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
	echo "settings:  DPMS_CYCLES=$DPMS_CYCLES SUSPEND_CYCLES=$SUSPEND_CYCLES MEASURE_SECS=$MEASURE_SECS IDLE_SECS=$IDLE_SECS"
} > "$OUT/info.txt"
[ -n "$EDP_SYS" ] && cp "$EDP_SYS/edid" "$OUT/edid.bin" 2>/dev/null
dmesg -c > "$OUT/dmesg/boot.log"
# The patched kernel logs this line when its panel quirk matches.
if grep -q 'Min DP pre-emphasis level' "$OUT/dmesg/boot.log"; then
	echo "quirk:     applied" >> "$OUT/info.txt"
else
	echo "quirk:     not applied" >> "$OUT/info.txt"
fi
save

if [ -z "$EDP_DBG" ] || [ "$(cat "$EDP_SYS/status" 2>/dev/null)" != connected ]; then
	echo "verdict: NO_PANEL (no connected eDP panel driven by amdgpu)" > "$OUT/summary.txt"
	finish "No internal panel found on an AMD GPU. Nothing was tested."
fi

dpcd() {	# dpcd <offset> <count> : DPCD bytes as hex, space separated
	[ -c "$AUX" ] || return 0
	timeout 2 dd if="$AUX" bs=1 skip=$(($1)) count="$2" 2>/dev/null |
		od -An -tx1 | tr -s ' \n' ' ' | sed 's/^ //; s/ $//'
}

errors() {	# errors : symbol error count per lane, "e0 e1 e2 e3"
	set -- $(dpcd 0x210 8)
	[ $# -eq 8 ] || { echo "-1 -1 -1 -1"; return; }
	echo "$(( (0x$2 << 8 | 0x$1) & 0x7fff )) $(( (0x$4 << 8 | 0x$3) & 0x7fff ))" \
	     "$(( (0x$6 << 8 | 0x$5) & 0x7fff )) $(( (0x$8 << 8 | 0x$7) & 0x7fff ))"
}

echo "phase,cycle,off_ms,retrained,vs,pe,early_sync,lane_status,err0,err1,err2,err3,psr_before,psr_after" > "$CSV"

psr_state() {	# PSR state of the panel as the driver sees it (0 = inactive)
	tr -d '\0\n' 2>/dev/null < "$EDP_DBG/psr_state" || echo -1
}

# Leave the screen alone for a moment, as on an idle desktop, so that PSR
# can engage before the panel is turned off. Sets PSR_BEFORE.
idle() {
	sleep "$IDLE_SECS"
	PSR_BEFORE=$(psr_state)
}

# Keep the picture changing, so that PSR does not shut the main link down
# while its errors are being counted.
busy() {	# busy <seconds>
	local t=0
	while [ "$t" -lt $(($1 * 20)) ]; do
		printf '\r  counting link errors %d ' "$t"
		usleep 50000
		t=$((t + 1))
	done
	printf '\r                              \r'
}

measure() {	# measure <phase> <cycle> <off_ms>
	local log phy vs pe retrained early status e psr_after
	log="$OUT/dmesg/$1-$(printf '%03d' "$2").log"
	sleep 2
	dmesg -c > "$log"
	# One "HBR3x4 pass VS=1, PE=2, DS=..." line per link training.
	retrained=$(grep -c 'VS=[0-9]*, PE=[0-9]*' "$log")
	# The bad trainings report "receive port in sync" (DPCD 0x205 bit 0)
	# while the lanes only have clock recovery.
	early=$(grep -c '0x00202 AUX -> (ret=  6) 11 11 00 01' "$log")
	phy=$(tr -d '\0' < "$EDP_DBG/phy_settings" 2>/dev/null)
	set -- $1 $2 $3 $phy
	vs=${4:--1}; pe=${5:--1}
	status=$(dpcd 0x202 6 | tr ' ' '_')
	psr_after=$(psr_state)
	errors > /dev/null			# reading clears the counters
	busy "$MEASURE_SECS"
	e=$(errors | tr ' ' ',')
	echo "$1,$2,$3,$retrained,$vs,$pe,$early,$status,$e,$PSR_BEFORE,$psr_after" >> "$CSV"
	say "$1 $2: trained VS=$vs PE=$pe  errors/lane: $e"
}

say "Panel: $EDP_SYS. Running $DPMS_CYCLES screen off/on cycles."
i=1
while [ "$i" -le "$DPMS_CYCLES" ]; do
	off_ms=$(( 300 + $(od -An -N2 -tu2 /dev/urandom) % 3700 ))
	idle
	echo 4 > "$FB_BLANK"
	usleep $((off_ms * 1000))
	echo 0 > "$FB_BLANK"
	measure dpms "$i" "$off_ms"
	[ $((i % SAVE_EVERY)) -eq 0 ] && save
	i=$((i + 1))
done

if [ "$SUSPEND_CYCLES" -gt 0 ]; then
	say "Running $SUSPEND_CYCLES suspend/resume cycles."
fi
i=1
while [ "$i" -le "$SUSPEND_CYCLES" ]; do
	secs=$(( 5 + $(od -An -N1 -tu1 /dev/urandom) % 10 ))
	echo "suspend $i: going to sleep for ${secs}s" >> "$OUT/progress.txt"
	save		# a suspend that never returns must not lose the run
	idle
	if ! rtcwake -m mem -s "$secs" > /dev/null 2>&1; then
		echo "suspend $i: rtcwake failed, skipping the rest" >> "$OUT/progress.txt"
		say "Suspend failed; skipping the remaining suspend cycles."
		break
	fi
	measure suspend "$i" $((secs * 1000))
	i=$((i + 1))
done

# Summary. A training counts as bad if it ended below pre-emphasis level 2
# or the link showed more than 10 symbol errors in the measuring window.
awk -F, -v variant="$VARIANT" '
NR > 1 {
	n++
	if ($4 > 0) trained++
	if ($6 >= 0 && $6 < 2) lowpe++
	if ($7 > 0) early++
	if ($9 + $10 + $11 + $12 > 10) errs++
	if ($9 < 0) noread++
	if ($13 > 0) psr++
}
END {
	printf "variant:                        %s\n", variant
	printf "cycles run:                     %d\n", n
	printf "cycles that retrained the link: %d\n", trained
	printf "ended below pre-emphasis 2:     %d\n", lowpe
	printf "early-sync signature seen:      %d\n", early
	printf "cycles with link errors:        %d\n", errs
	printf "cycles without error readout:   %d\n", noread
	printf "PSR active when turned off:     %d\n", psr
	if (n == 0 || trained == 0)
		v = "INCONCLUSIVE (the link was never retrained)"
	else if (lowpe > 0 || errs > 0)
		v = "BAD (weak training or link errors seen)"
	else
		v = "GOOD (every training ended at level 2 or above, no link errors)"
	printf "verdict: %s\n", v
}' "$CSV" > "$OUT/summary.txt"

cat "$OUT/summary.txt"
finish "Test finished: $(grep '^verdict' "$OUT/summary.txt")"
